<!--
╔══════════════════════════════════════════════════════════════════════════════╗
║          INSAIT STYLE  –  Шаблон маленького вікна (Avalonia UI)            ║
║                                                                              ║
║  Тема: Fluent Orange-Purple Dark  (скопійовано з Insait Edit C# IDE)        ║
║                                                                              ║
║  ▶ ЯК ВИКОРИСТОВУВАТИ:                                                       ║
║    1. Скопіюй цей файл у свій проект (напр., MyDialog.axaml).               ║
║    2. Замін x:Class="YourNamespace.YourWindowClass" на свій клас.           ║
║    3. Прибери з Window.Styles усе зайве або додай власні стилі.             ║
║    4. Видали коментар-інструкцію (цей блок).                                ║
║                                                                              ║
║  ▶ ЗАЛЕЖНОСТІ:                                                               ║
║    – Avalonia UI (будь-яка версія ≥ 11)                                     ║
║    – Шрифти: Segoe UI / Segoe UI Emoji / Cascadia Code (усі стандартні)     ║
║    – Іконки НЕ потрібні — використовуються символи Unicode / Emoji           ║
║                                                                              ║
║  ▶ ЦЕЙ ФАЙЛ НЕ ПІДКЛЮЧЕНИЙ ДО ДОДАТКА Insait Edit і є чистим ШАБЛОНОМ.     ║
╚══════════════════════════════════════════════════════════════════════════════╝
-->

<!--
    ЗАМІНИ ЦЕ:
      x:Class="YourNamespace.YourWindowClass"
    на свій повний клас (наприклад: x:Class="MediaPlayer.SettingsWindow")
    
    Якщо хочеш запустити без code-behind — просто видали атрибут x:Class.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="480" d:DesignHeight="320"

        Title="My Window"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Width="480"
        Height="320"
        MinWidth="360"
        MinHeight="220"
        CanResize="False"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI, Arial, Tahoma">

    <!-- ═══════════════════════════════════════════════════════════════════
         ПАЛІТРА КОЛЬОРІВ  —  Fluent Orange-Purple Dark Theme
         Скопіюй у Window.Resources або в App.axaml для глобального доступу
         ═══════════════════════════════════════════════════════════════════ -->
    <Window.Resources>

        <!-- ── Базові кольори фону ── -->
        <Color x:Key="AppBgColor">#FF1F1A24</Color>         <!-- головний фон вікна -->
        <Color x:Key="AppSurfaceColor">#FF2A2230</Color>    <!-- поверхня панелей  -->
        <Color x:Key="AppBorderColor">#FF3E3050</Color>     <!-- рамки / роздільники -->
        <Color x:Key="AppTextColor">#FFF0E8F4</Color>       <!-- основний текст -->
        <Color x:Key="AppTextMutedColor">#FF9E90B0</Color>  <!-- приглушений текст -->

        <!-- ── Акцентні кольори ── -->
        <!-- Помаранчевий — PRIMARY: заголовки, активні вкладки, кнопки OK -->
        <Color x:Key="AccentOrangeColor">#FFFFC09F</Color>
        <Color x:Key="AccentOrangeHoverColor">#FFFFD4B8</Color>
        <!-- Фіолетовий — SECONDARY: AI, інструменти, hover-підсвічування -->
        <Color x:Key="AccentPurpleColor">#FFDCC4FF</Color>
        <Color x:Key="AccentPurpleHoverColor">#FFECD8FF</Color>
        <!-- Семантичні кольори -->
        <Color x:Key="AccentGreenColor">#FFA6E3A1</Color>   <!-- успіх / запуск -->
        <Color x:Key="AccentBlueColor">#FF89B4FA</Color>    <!-- інформація -->
        <Color x:Key="AccentRedColor">#FFF38BA8</Color>     <!-- помилки -->

        <!-- ── Пензлі ── -->
        <SolidColorBrush x:Key="AppBgBrush"          Color="{StaticResource AppBgColor}"/>
        <SolidColorBrush x:Key="AppSurfaceBrush"     Color="{StaticResource AppSurfaceColor}"/>
        <SolidColorBrush x:Key="AppBorderBrush"      Color="{StaticResource AppBorderColor}"/>
        <SolidColorBrush x:Key="AppTextBrush"        Color="{StaticResource AppTextColor}"/>
        <SolidColorBrush x:Key="AppTextMutedBrush"   Color="{StaticResource AppTextMutedColor}"/>
        <SolidColorBrush x:Key="AccentOrangeBrush"   Color="{StaticResource AccentOrangeColor}"/>
        <SolidColorBrush x:Key="AccentOrangeHoverBrush" Color="{StaticResource AccentOrangeHoverColor}"/>
        <SolidColorBrush x:Key="AccentPurpleBrush"   Color="{StaticResource AccentPurpleColor}"/>
        <SolidColorBrush x:Key="AccentPurpleHoverBrush" Color="{StaticResource AccentPurpleHoverColor}"/>
        <SolidColorBrush x:Key="AccentGreenBrush"    Color="{StaticResource AccentGreenColor}"/>
        <SolidColorBrush x:Key="AccentBlueBrush"     Color="{StaticResource AccentBlueColor}"/>
        <SolidColorBrush x:Key="AccentRedBrush"      Color="{StaticResource AccentRedColor}"/>

        <!-- ── Градієнти ── -->
        <!-- Сайдбар (помаранчевий) -->
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFF8830" Offset="0"/>
            <GradientStop Color="#FFFF6A10" Offset="1"/>
        </LinearGradientBrush>
        <!-- Рядок заголовка -->
        <SolidColorBrush x:Key="TitleBarBrush" Color="#FF2D2438"/>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════
         СТИЛІ КОМПОНЕНТІВ  —  копіюй потрібні в своє вікно або App.axaml
         ═══════════════════════════════════════════════════════════════════ -->
    <Window.Styles>

        <!-- ── Кнопка закриття / мінімізації вікна ── -->
        <Style Selector="Button.window-control">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="36"/>
            <Setter Property="Height"           Value="32"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#20FFDAB0"/>
        </Style>
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#CCE53935"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ── Основна кнопка (помаранчева) — OK, Save, Apply ── -->
        <Style Selector="Button.primary-btn">
            <Setter Property="Background"    Value="{StaticResource AccentOrangeBrush}"/>
            <Setter Property="Foreground"    Value="#FF1F1A24"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"  Value="6"/>
            <Setter Property="Padding"       Value="20,9"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentOrangeHoverBrush}"/>
        </Style>
        <Style Selector="Button.primary-btn:pressed">
            <Setter Property="Background" Value="#FFE09070"/>
        </Style>

        <!-- ── Вторинна кнопка (фіолетова) — Cancel, Back ── -->
        <Style Selector="Button.secondary-btn">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="{StaticResource AppTextMutedBrush}"/>
            <Setter Property="BorderBrush"   Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"  Value="6"/>
            <Setter Property="Padding"       Value="20,9"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.secondary-btn:pointerover">
            <Setter Property="Background" Value="#25DCC4FF"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
        </Style>
        <Style Selector="Button.secondary-btn:pressed">
            <Setter Property="Background" Value="#40DCC4FF"/>
        </Style>

        <!-- ── Небезпечна кнопка (червона) — Delete, Remove ── -->
        <Style Selector="Button.danger-btn">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="BorderBrush"   Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"  Value="6"/>
            <Setter Property="Padding"       Value="20,9"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.danger-btn:pointerover">
            <Setter Property="Background" Value="#25F38BA8"/>
        </Style>

        <!-- ── Іконічна кнопка (без фону, лише іконка) ── -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Width"         Value="32"/>
            <Setter Property="Height"        Value="32"/>
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"  Value="6"/>
            <Setter Property="Padding"       Value="0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="#20FFDAB0"/>
        </Style>
        <Style Selector="Button.icon-btn:pressed">
            <Setter Property="Background" Value="#35FFDAB0"/>
        </Style>

        <!-- ── Поле вводу (TextBox) — світле на темному фоні ── -->
        <Style Selector="TextBox">
            <Setter Property="Foreground"               Value="#FF1F1A24"/>
            <Setter Property="Background"               Value="#FFF7F2EC"/>
            <Setter Property="BorderBrush"              Value="#FFB8A6C4"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="CornerRadius"             Value="6"/>
            <Setter Property="Padding"                  Value="10,7"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="CaretBrush"               Value="#FF6C2FA0"/>
            <Setter Property="SelectionBrush"           Value="#66E9C9B8"/>
            <Setter Property="SelectionForegroundBrush" Value="#FF1F1A24"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFF7F2EC"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFAF7F3"/>
        </Style>
        <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFAF7F3"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}"/>
        </Style>
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource AppTextMutedBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- ── ComboBox — темна тема ── -->
        <Style Selector="ComboBox">
            <Setter Property="Background"      Value="{StaticResource AppSurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground"  Value="{StaticResource AppTextBrush}"/>
            <Setter Property="Background"  Value="{StaticResource AppSurfaceBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background"  Value="#25FFC09F"/>
            <Setter Property="Foreground"  Value="{StaticResource AccentOrangeBrush}"/>
        </Style>

        <!-- ── CheckBox — темна тема ── -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AppTextMutedBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background"  Value="{StaticResource AccentOrangeBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}"/>
        </Style>

        <!-- ── Виділяємий текст (SelectableTextBlock) ── -->
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionBrush"           Value="#60FFC09F"/>
            <Setter Property="SelectionForegroundBrush" Value="#FF1F1A24"/>
        </Style>

        <!-- ── Панель / картка (Border.card) ── -->
        <Style Selector="Border.card">
            <Setter Property="Background"      Value="{StaticResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14"/>
        </Style>

        <!-- ── Мітка-підказка (TextBlock.hint) ── -->
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground"   Value="{StaticResource AppTextMutedBrush}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ── Мітка поля форми (TextBlock.label) ── -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground"  Value="{StaticResource AccentOrangeBrush}"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- ── MenuItem ── -->
        <Style Selector="MenuItem">
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI, Arial"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

    </Window.Styles>

    <!-- ═══════════════════════════════════════════════════════════════════
         СТРУКТУРА ВІКНА  —  зовнішня рамка з тінню
         ═══════════════════════════════════════════════════════════════════ -->
    <Border Background="{StaticResource AppBgBrush}"
            BorderBrush="#FF7C3AED"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">

        <!-- Зовнішня тінь (purple glow) -->
        <Border.Effect>
            <DropShadowEffect Color="#CC3E1060"
                              BlurRadius="28"
                              OffsetX="0" OffsetY="8"
                              Opacity="0.75"/>
        </Border.Effect>

        <!-- Сітка: titlebar | content | footer -->
        <Grid RowDefinitions="36,*,Auto">

            <!-- ── РЯДОК ЗАГОЛОВКА ── -->
            <!--
                Щоб вікно можна було перетягувати:
                  1. У code-behind додай: TitleBar.PointerPressed += (_, e) => BeginMoveDrag(e);
                  2. Або: Name="TitleBar" і в cs: TitleBar.PointerPressed += (s,e) => BeginMoveDrag(e);
            -->
            <Border Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    CornerRadius="10,10,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Іконка + назва вікна -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0"
                                Spacing="8">
                        <!-- Замін емодзі на потрібне або прибери -->
                        <TextBlock Text="⚙️"
                                   FontSize="14"
                                   FontFamily="Segoe UI Emoji"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Назва вікна"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Порожнє місце (draggable area) -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Кнопки керування вікном -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch">
                        <!-- Кнопка закриття -->
                        <Button Name="CloseButton"
                                Classes="window-control close"
                                ToolTip.Tip="Закрити">
                            <!-- Click="CloseButton_Click" — підключи у code-behind -->
                            <TextBlock Text="✕"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ── ОСНОВНИЙ ВМІСТ (заміни під своє вікно) ── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,20,10" Spacing="16">

                    <!-- Приклад: форма з полями -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Назва"/>
                        <TextBox Watermark="Введіть значення…"/>
                        <TextBlock Classes="hint" Text="Підказка або опис поля (необов'язково)."/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Вибір зі списку"/>
                        <ComboBox HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Варіант 1"/>
                            <ComboBoxItem Content="Варіант 2"/>
                            <ComboBoxItem Content="Варіант 3"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Приклад: картка-інформер -->
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="💡 Підказка"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentPurpleBrush}"/>
                            <TextBlock Classes="hint"
                                       Text="Тут може бути корисна інформація або попередження для користувача."/>
                        </StackPanel>
                    </Border>

                    <CheckBox Content="Увімкнути опцію" IsChecked="True"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ── НИЖНЯ ПАНЕЛЬ: кнопки дій ── -->
            <Border Grid.Row="2"
                    Background="#10FFFFFF"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid ColumnDefinitions="*,12,Auto,8,Auto">
                    <!-- Ліва частина: допоміжна кнопка або пуста -->
                    <Button Grid.Column="0"
                            Classes="icon-btn"
                            ToolTip.Tip="Довідка"
                            HorizontalAlignment="Left">
                        <TextBlock Text="❓" FontSize="14" FontFamily="Segoe UI Emoji"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Cancel / Back -->
                    <Button Grid.Column="2"
                            Classes="secondary-btn"
                            MinWidth="100">
                        <!-- Click="CancelButton_Click" -->
                        <TextBlock Text="Скасувати"/>
                    </Button>

                    <!-- OK / Save / Apply -->
                    <Button Grid.Column="4"
                            Classes="primary-btn"
                            MinWidth="100">
                        <!-- Click="OkButton_Click" -->
                        <TextBlock Text="Застосувати"/>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>

</Window>

