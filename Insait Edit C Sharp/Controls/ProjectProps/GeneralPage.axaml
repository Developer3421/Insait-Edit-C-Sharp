<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Insait_Edit_C_Sharp.Controls.ProjectProps.GeneralPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="28,16,28,28">
        <StackPanel Spacing="0">

            <!-- Application Icon -->
            <Border Background="#FF1C1530" BorderBrush="#FF3A2E52" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                <Grid ColumnDefinitions="88,*">
                    <Border Grid.Column="0" Width="80" Height="80"
                            Background="#FF14102A" CornerRadius="10"
                            BorderBrush="#FF3A2E52" BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Panel>
                            <TextBlock Name="AppIconPlaceholder" Text="🖼" FontSize="30"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Name="AppIconPreview" Width="64" Height="64" IsVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource ProjectProps.General.AppIconFile}" Classes="prop-label" Margin="0"/>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Name="AppIconPathBox" Grid.Column="0" Watermark="Path to .ico file…"/>
                            <Button Grid.Column="1" Name="BrowseIconButton"
                                    Content="{DynamicResource Common.Browse}" Classes="small-btn"
                                    Margin="6,0,0,0" ToolTip.Tip="{DynamicResource ProjectProps.General.SelectIconTooltip}"/>
                            <Button Grid.Column="2" Name="ClearIconButton"
                                    Content="✕" Width="34" Classes="small-btn"
                                    Margin="4,0,0,0" ToolTip.Tip="{DynamicResource Publish.ClearIcon}"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource ProjectProps.General.AppIconHint}"
                                   Classes="info-text"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{DynamicResource ProjectProps.AssemblyName}" Classes="prop-label"/>
            <TextBox Name="AssemblyNameBox" Watermark="e.g. MyApp" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource ProjectProps.DefaultNamespace}" Classes="prop-label"/>
            <TextBox Name="DefaultNamespaceBox" Watermark="e.g. MyApp" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource ProjectProps.TargetFramework}" Classes="prop-label"/>
            <ComboBox Name="TargetFrameworkCombo" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                <ComboBoxItem Content="net10.0"/>
                <ComboBoxItem Content="net9.0"/>
                <ComboBoxItem Content="net8.0"/>
                <ComboBoxItem Content="net7.0"/>
                <ComboBoxItem Content="net6.0"/>
                <ComboBoxItem Content="net5.0"/>
                <ComboBoxItem Content="netcoreapp3.1"/>
                <ComboBoxItem Content="netstandard2.1"/>
                <ComboBoxItem Content="netstandard2.0"/>
                <ComboBoxItem Content="net48"/>
                <ComboBoxItem Content="net472"/>
                <ComboBoxItem Content="net462"/>
            </ComboBox>

            <TextBlock Text="{DynamicResource ProjectProps.OutputType}" Classes="prop-label"/>
            <ComboBox Name="OutputTypeCombo" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                <ComboBoxItem Content="Console Application" Tag="Exe"/>
                <ComboBoxItem Content="Windows Application" Tag="WinExe"/>
                <ComboBoxItem Content="Class Library" Tag="Library"/>
            </ComboBox>

            <TextBlock Text="{DynamicResource ProjectProps.LangVersion}" Classes="prop-label"/>
            <ComboBox Name="LangVersionCombo" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                <ComboBoxItem Content="default"     Tag="default"/>
                <ComboBoxItem Content="latest"      Tag="latest"/>
                <ComboBoxItem Content="latestMajor" Tag="latestMajor"/>
                <ComboBoxItem Content="preview"     Tag="preview"/>
                <ComboBoxItem Content="C# 13"       Tag="13.0"/>
                <ComboBoxItem Content="C# 12"       Tag="12.0"/>
                <ComboBoxItem Content="C# 11"       Tag="11.0"/>
                <ComboBoxItem Content="C# 10"       Tag="10.0"/>
                <ComboBoxItem Content="C# 9"        Tag="9.0"/>
                <ComboBoxItem Content="C# 8"        Tag="8.0"/>
                <ComboBoxItem Content="C# 7.3"      Tag="7.3"/>
                <ComboBoxItem Content="C# 7.2"      Tag="7.2"/>
                <ComboBoxItem Content="C# 7.1"      Tag="7.1"/>
                <ComboBoxItem Content="C# 7"        Tag="7"/>
                <ComboBoxItem Content="C# 6"        Tag="6"/>
                <ComboBoxItem Content="C# 5"        Tag="5"/>
                <ComboBoxItem Content="C# 4"        Tag="4"/>
                <ComboBoxItem Content="C# 3"        Tag="3"/>
            </ComboBox>


        </StackPanel>
    </ScrollViewer>
</UserControl>
