<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Insait_Edit_C_Sharp.Controls.ExplorerNodeMenuWindow"
        Title="Node Menu"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        SystemDecorations="None"
        Width="262"
        MinWidth="220"
        MaxWidth="310"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI, Arial, Tahoma"
        Background="Transparent">

    <Window.Styles>
        <!-- Compact flat menu item -->
        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,1,4,0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.menu-item:pointerover">
            <Setter Property="Background" Value="#20FFFFFF"/>
        </Style>
        <Style Selector="Button.menu-item:pressed">
            <Setter Property="Background" Value="#35FFC09F"/>
        </Style>
        <Style Selector="Button.menu-item.destructive">
            <Setter Property="Foreground" Value="#FFF7C6D0"/>
        </Style>
        <Style Selector="Button.menu-item.destructive:pointerover">
            <Setter Property="Background" Value="#22F38BA8"/>
        </Style>
        <Style Selector="TextBlock.item-text">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI, Arial"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Styles>

    <Border Background="#FF1E1A28"
            BorderBrush="#FF4A3870"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#CC000000" BlurRadius="16" OffsetX="0" OffsetY="4" Opacity="0.65"/>
        </Border.Effect>

        <Grid RowDefinitions="Auto,Auto">
            <!-- Header (compact) -->
            <Border Grid.Row="0" Padding="10,6,6,6"
                    Background="#10FFFFFF" CornerRadius="8,8,0,0"
                    BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1"
                    Name="TitleBar" PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="TitleIcon" Text="📁" FontSize="13"
                               FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="Node Menu"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#FFF0E8F4" Margin="7,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" x:Name="CloseTitleBtn"
                            Background="Transparent" BorderThickness="0"
                            Width="24" Height="24" Padding="0" Cursor="Hand"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Image Source="avares://Insait Edit C Sharp/Icons/CloseButton.png"
                               Width="16" Height="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Actions (compact flat list) -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="420">
                <StackPanel x:Name="ActionHost" Margin="0,3,0,5"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

