<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Insait_Edit_C_Sharp.Controls.ExplorerNodeMenuWindow"
        Title="Node Menu"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        Width="360"
        MinWidth="320"
        MaxWidth="420"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI, Arial, Tahoma"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
            <Setter Property="BorderBrush" Value="#FF3E3050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Background" Value="#162A2230"/>
            <Setter Property="BorderBrush" Value="#FFFFC09F"/>
        </Style>
        <Style Selector="Button.action-btn.destructive">
            <Setter Property="BorderBrush" Value="#885F2A3A"/>
            <Setter Property="Foreground" Value="#FFF7C6D0"/>
        </Style>
        <Style Selector="Button.action-btn.destructive:pointerover">
            <Setter Property="Background" Value="#20A8324A"/>
            <Setter Property="BorderBrush" Value="#FFF38BA8"/>
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="Foreground" Value="#FFDCC4FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>
        <Style Selector="TextBlock.action-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
        </Style>
        <Style Selector="TextBlock.action-subtitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FF9E90B0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Styles>

    <Border Background="#FF1F1A24"
            BorderBrush="#FF7C3AED"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#CC3E1060" BlurRadius="24" OffsetX="0" OffsetY="8" Opacity="0.8"/>
        </Border.Effect>

        <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Background="#18DCC4FF" Padding="14,8" CornerRadius="10,10,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TitleIcon" Text="📁" FontSize="14"
                                   FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText" Text="Node Menu"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFF0E8F4" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="CloseTitleBtn"
                            Content="✕" Width="28" Height="28"
                            Background="Transparent" Foreground="#FF9E90B0"
                            BorderThickness="0" FontSize="13" Cursor="Hand"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="520">
                <StackPanel x:Name="ActionHost" Margin="16,12,16,10"/>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16,8" Background="#10DCC4FF" CornerRadius="0,0,10,10">
                <TextBlock Text="Click an action or press Esc to close"
                           FontSize="11"
                           Foreground="#FF9E90B0"/>
            </Border>
        </Grid>
    </Border>
</Window>

