<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Insait_Edit_C_Sharp.PublishWindow"
        Title="{DynamicResource Publish.Title}"
        Width="700"
        Height="650"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="None"
        Background="#FF1F1A24">
    
    <Window.Styles>
        <Style Selector="Button.action-button">
            <Setter Property="Background" Value="#FF3E3050"/>
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-button:pointerover">
            <Setter Property="Background" Value="#FF4A3D58"/>
        </Style>
        <Style Selector="Button.primary-button">
            <Setter Property="Background" Value="#FFFFC09F"/>
            <Setter Property="Foreground" Value="#FF1F1A24"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary-button:pointerover">
            <Setter Property="Background" Value="#FFFFD4B8"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FF2E1B0C"/>
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
            <Setter Property="BorderBrush" Value="#FF3E3050"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="SelectionBrush" Value="#60FFC09F"/>
            <Setter Property="SelectionForegroundBrush" Value="#FF1F1A24"/>
            <Setter Property="CaretBrush" Value="#5B1E8C"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FF2E1B0C"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FF352840"/>
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
            <Setter Property="BorderBrush" Value="#FF3E3050"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
        </Style>
        
        <!-- Emoji icons style - preserve natural colors -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI, Arial"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="#FF3E3050" BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="36,*,Auto">
            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#FF3C3C3C" CornerRadius="8,8,0,0" Name="TitleBar">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="12,0">
                        <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Publish.TitleBar}" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#FFF0E8F4" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Background="Transparent" Foreground="#FF9E90B0"
                            BorderThickness="0" Width="36" Height="36" Name="CloseButton">
                        <Image Source="avares://Insait Edit C Sharp/Icons/CloseButton.png" Width="26" Height="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Spacing="20">
                    <!-- Project Selection -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Publish.Project}" FontWeight="SemiBold" Foreground="#FFF0E8F4" FontSize="13"/>
                        <ComboBox Name="ProjectComboBox" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Deployment Mode -->
                    <Border Background="#FF2A2230" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource Publish.DeploymentMode}" FontWeight="SemiBold" Foreground="#FFFFC09F" FontSize="13"/>
                            <RadioButton Content="{DynamicResource Publish.FrameworkDependent}" 
                                         Name="FrameworkDependentRadio" IsChecked="True" GroupName="DeploymentMode"/>
                            <RadioButton Content="{DynamicResource Publish.SelfContained}" 
                                         Name="SelfContainedRadio" GroupName="DeploymentMode"/>
                        </StackPanel>
                    </Border>

                    <!-- Target Runtime -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Publish.Configuration}" FontWeight="SemiBold" Foreground="#FFF0E8F4" FontSize="13"/>
                            <ComboBox Name="ConfigurationComboBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{DynamicResource Publish.ConfigurationRelease}" Tag="Release" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Publish.ConfigurationDebug}" Tag="Debug"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource Publish.TargetRuntime}" FontWeight="SemiBold" Foreground="#FFF0E8F4" FontSize="13"/>
                            <ComboBox Name="RuntimeComboBox" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <!-- Target Framework -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Publish.TargetFramework}" FontWeight="SemiBold" Foreground="#FFF0E8F4" FontSize="13"/>
                        <ComboBox Name="FrameworkComboBox" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Output Path -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Publish.OutputFolder}" FontWeight="SemiBold" Foreground="#FFF0E8F4" FontSize="13"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="OutputPathBox" Watermark="{DynamicResource Publish.OutputPlaceholder}"/>
                            <Button Grid.Column="1" Content="📁" Classes="action-button" Margin="8,0,0,0" Width="40" Name="BrowseOutputButton"/>
                        </Grid>
                    </StackPanel>

                    <!-- Application Icon -->
                    <Border Background="#FF2A2230" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{DynamicResource Publish.ApplicationIcon}" FontWeight="SemiBold" Foreground="#FFFFC09F" FontSize="13"/>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Icon preview -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                        Background="#FF352840" BorderBrush="#FF3E3050" BorderThickness="1"
                                        Margin="0,0,12,0" Name="IconPreviewBorder">
                                    <Panel>
                                        <TextBlock Text="🖼️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Name="IconPlaceholder"/>
                                        <Image Name="IconPreviewImage" Width="40" Height="40" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="False"/>
                                    </Panel>
                                </Border>
                                <TextBox Grid.Column="1" Name="IconPathBox" Watermark="{DynamicResource Publish.IconPlaceholder}"
                                         IsReadOnly="True" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="📁" Classes="action-button" Margin="8,0,0,0" Width="40" 
                                            Name="BrowseIconButton" ToolTip.Tip="{DynamicResource Publish.BrowseIcon}"/>
                                    <Button Content="✕" Classes="action-button" Margin="4,0,0,0" Width="32"
                                            Name="ClearIconButton" ToolTip.Tip="{DynamicResource Publish.ClearIcon}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource Publish.IconHint}"
                                       FontSize="11" Foreground="#FF9E90B0" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- Publish Options -->
                    <Border Background="#FF2A2230" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12" x:CompileBindings="False">
                            <TextBlock Text="{DynamicResource Publish.Options}" FontWeight="SemiBold" Foreground="#FFFFC09F" FontSize="13"/>
                            
                            <CheckBox Content="{DynamicResource Publish.SingleFile}" Name="SingleFileCheck" ToolTip.Tip="{DynamicResource Publish.SingleFileTooltip}"/>
                            
                            <CheckBox Content="{DynamicResource Publish.ReadyToRun}" Name="ReadyToRunCheck" 
                                      ToolTip.Tip="{DynamicResource Publish.ReadyToRunTooltip}"/>
                            
                            <CheckBox Content="{DynamicResource Publish.Trim}" Name="TrimCheck" 
                                      ToolTip.Tip="{DynamicResource Publish.TrimTooltip}"/>
                            
                            <CheckBox Content="{DynamicResource Publish.Compression}" Name="CompressionCheck" 
                                      ToolTip.Tip="{DynamicResource Publish.CompressionTooltip}" IsEnabled="{Binding #SingleFileCheck.IsChecked, FallbackValue=False}"/>
                            
                            <CheckBox Content="{DynamicResource Publish.NativeLibs}" Name="NativeLibrariesCheck"
                                      ToolTip.Tip="{DynamicResource Publish.NativeLibsTooltip}" IsEnabled="{Binding #SingleFileCheck.IsChecked, FallbackValue=False}"/>
                            
                            <Border Height="1" Background="#FF3E3050" Margin="0,4"/>
                            
                            <CheckBox Content="{DynamicResource Publish.CleanOutput}" Name="CleanOutputCheck" IsChecked="True"
                                      ToolTip.Tip="{DynamicResource Publish.CleanOutputTooltip}"/>
                        </StackPanel>
                    </Border>

                    <!-- Publish Profiles -->
                    <Border Background="#FF2A2230" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource Publish.PublishProfile}" FontWeight="SemiBold" Foreground="#FF89B4FA" FontSize="13"/>
                                <Button Grid.Column="1" Content="{DynamicResource Publish.NewProfile}" Classes="action-button" FontSize="11" Name="NewProfileButton"/>
                            </Grid>
                            <ComboBox Name="PublishProfileComboBox" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{DynamicResource Publish.ProfileHint}" 
                                       FontSize="11" Foreground="#FF9E90B0" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Presets -->
                    <Border Background="#FF2A2230" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource Publish.QuickPresets}" FontWeight="SemiBold" Foreground="#FFA6E3A1" FontSize="13"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Publish.PresetWinX64}" Classes="action-button" Margin="0,0,8,8" Name="PresetWinX64Button"/>
                                <Button Content="{DynamicResource Publish.PresetWinArm64}" Classes="action-button" Margin="0,0,8,8" Name="PresetWinArm64Button"/>
                                <Button Content="{DynamicResource Publish.PresetLinuxX64}" Classes="action-button" Margin="0,0,8,8" Name="PresetLinuxX64Button"/>
                                <Button Content="{DynamicResource Publish.PresetMacX64}" Classes="action-button" Margin="0,0,8,8" Name="PresetMacX64Button"/>
                                <Button Content="{DynamicResource Publish.PresetMacArm64}" Classes="action-button" Margin="0,0,8,8" Name="PresetMacArm64Button"/>
                                <Button Content="{DynamicResource Publish.PresetPortable}" Classes="action-button" Margin="0,0,8,8" Name="PresetPortableButton"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#FF2A2230" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Publish.EstimatedSize}" FontSize="11" 
                                   Foreground="#FF9E90B0" VerticalAlignment="Center" Name="EstimatedSizeText"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="{DynamicResource Publish.Cancel}" Classes="action-button" Name="CancelButton"/>
                        <Button Content="{DynamicResource Publish.Publish}" Classes="primary-button" Name="PublishButton"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

