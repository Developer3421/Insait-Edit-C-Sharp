<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Icons\AppIconIDE.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Publish: no PDB files -->
    <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' Or '$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
        <PackageReference Include="FSharp.Compiler.Service" Version="43.12.204" />
        <PackageReference Include="GitForWindows" Version="2.54.0" />
        <!-- Iciclecreek.Avalonia.Terminal removed — replaced by Process-based InsaitTerminalPanel -->
        <PackageReference Include="LiteDB" Version="6.0.0-prerelease.77" />
        <PackageReference Include="Microsoft.Build" Version="18.7.1" />
        <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.7.1" />
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.3.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100-preview.4.26230.115">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.Scripting.Common" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
        <PackageReference Include="Microsoft.TemplateEngine.Abstractions" Version="11.0.100-preview.3.26207.106" />
        <PackageReference Include="Microsoft.TemplateEngine.Edge" Version="11.0.100-preview.2.26159.112" />
        <PackageReference Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" Version="8.0.403" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="NuGet.Protocol" Version="7.6.0" />
        <PackageReference Include="Octokit" Version="14.0.0" />
        <PackageReference Include="System.Drawing.Common" Version="11.0.0-preview.1.26104.118" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Analyzer\Analyzer\Analyzer.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Insait Code Editor\" />
      <Folder Include="NotificationWindows\" />
      <Folder Include="ViewModels\" />
    </ItemGroup>

    <!-- Amber Fluent Editor — власний редактор коду з Roslyn Classification -->
    
    <!-- InsaitEditor — повноцінний редактор коду (Insait Code Editor) -->
    <ItemGroup>
     
      <Compile Update="Insait Code Editor\InsaitEditor.axaml.cs">
        <DependentUpon>InsaitEditor.axaml</DependentUpon>
      </Compile>
    </ItemGroup>

    
    <!-- Include React UI build output -->
    <ItemGroup>
      <EmbeddedResource Include="React Ui\dist\**\*" Condition="Exists('React Ui\dist\')" />
      <Content Include="React Ui\dist\**\*" Condition="Exists('React Ui\dist\')" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Icons\MaxButton.png" />
      <AvaloniaResource Include="Icons\MaxButton.png" />
      <None Remove="Icons\MinButton.png" />
      <AvaloniaResource Include="Icons\MinButton.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AvaloniaResource>
      <None Remove="Icons\CloseButton.png" />
      <AvaloniaResource Include="Icons\CloseButton.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AvaloniaResource>
      <None Remove="Icons\AppIconIDE.png" />
      <AvaloniaResource Include="Icons\AppIconIDE.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AvaloniaResource>
      <None Remove="Icons\AppIconIDE.ico" />
      <AvaloniaResource Include="Icons\AppIconIDE.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AvaloniaResource>
    </ItemGroup>
    <ItemGroup>
      <Compile Update="MainWindow.Methods.cs">
        <DependentUpon>MenuWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Controls\ConfirmDialog.axaml.cs">
        <DependentUpon>ConfirmDialog.axaml</DependentUpon>
      </Compile>
      <Compile Update="PreviewErrorWindow.axaml.cs">
        <DependentUpon>PreviewErrorWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="AxamlLiveHost.axaml.cs">
        <DependentUpon>AxamlLiveHost.axaml</DependentUpon>
      </Compile>

      <Compile Update="Terminal\InsaitTerminalPanel.axaml.cs">
        <DependentUpon>InsaitTerminalPanel.axaml</DependentUpon>
      </Compile>
    </ItemGroup>
    <ItemGroup>
      <None Remove="Icons\KiloCodeIcon.png" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="Icons\kilocode (1).png" />
      <AvaloniaResource Include="Icons\KiloCodeIcon.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </AvaloniaResource>
    </ItemGroup>
</Project>
