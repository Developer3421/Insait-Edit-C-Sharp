<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:Insait_Edit_C_Sharp.Services"
        x:Class="Insait_Edit_C_Sharp.RunConfigurationsWindow"
        Title="Run Configurations"
        Width="820"
        Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="None"
        Background="#FF1F1A24">
    
    <Window.Styles>
        <Style Selector="Button.action-button">
            <Setter Property="Background" Value="#FF3E3050"/>
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-button:pointerover">
            <Setter Property="Background" Value="#FF4A3D58"/>
        </Style>
        <Style Selector="Button.action-button:pressed">
            <Setter Property="Background" Value="#FF564268"/>
        </Style>
        <Style Selector="Button.primary-button">
            <Setter Property="Background" Value="#FFFFC09F"/>
            <Setter Property="Foreground" Value="#FF1F1A24"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary-button:pointerover">
            <Setter Property="Background" Value="#FFFFD4B8"/>
        </Style>
        <Style Selector="Button.primary-button:pressed">
            <Setter Property="Background" Value="#FFE09070"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#20FFDAB0"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#40FFC09F"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FFF7F2EC"/>
            <Setter Property="Foreground" Value="#FF1F1A24"/>
            <Setter Property="BorderBrush" Value="#FFB8A6C4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="SelectionBrush" Value="#66E9C9B8"/>
            <Setter Property="SelectionForegroundBrush" Value="#FF1F1A24"/>
            <Setter Property="CaretBrush" Value="#FF6C2FA0"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFF7F2EC"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#FFFFC09F"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FF352840"/>
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
            <Setter Property="BorderBrush" Value="#FF4A3D58"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#FFF0E8F4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI, Arial"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="#FF3E3050" BorderThickness="1" CornerRadius="10">
        <Grid RowDefinitions="38,*,Auto">

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#FF3C3C3C" CornerRadius="10,10,0,0" Name="TitleBar">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="14,0">
                        <TextBlock Text="▶" FontSize="15" Foreground="#FFFFC09F" VerticalAlignment="Center"/>
                        <TextBlock Text="Run Configurations" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFFFC09F" VerticalAlignment="Center" Name="TitleBarText"/>
                        <Border Background="#FF3E3050" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                            <TextBlock Text="Run &amp; Build" FontSize="10" Foreground="#FF9E90B0" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Background="Transparent" Foreground="#FF9E90B0"
                            BorderThickness="0" Width="38" Height="38" Name="CloseButton"
                            CornerRadius="0,10,0,0" Cursor="Hand">
                        <Image Source="avares://Insait Edit C Sharp/Icons/CloseButton.png" Width="26" Height="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" ColumnDefinitions="256,*">

                <!-- Left Panel: Configuration List -->
                <Border Grid.Column="0" Background="#FF1C1726" BorderBrush="#FF3E3050" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Search -->
                        <Border Grid.Row="0" Padding="8,10,8,6">
                            <TextBox Watermark="🔍 Пошук конфігурацій..." Name="SearchBox"/>
                        </Border>

                        <!-- Configuration List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,4">

                                <!-- Single section header -->
                                <Border Padding="12,6,12,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="3" Height="12" Background="#FFFFC09F" CornerRadius="2" VerticalAlignment="Center"/>
                                        <TextBlock Text="ОДИНОЧНІ" FontSize="10" FontWeight="Bold"
                                                   Foreground="#FFFFC09F" LetterSpacing="1" VerticalAlignment="Center" Name="SingleHeader"/>
                                    </StackPanel>
                                </Border>
                                <ListBox Name="ConfigurationsList" Background="Transparent"
                                         Margin="4,0" SelectionChanged="ConfigurationsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:RunConfiguration" x:CompileBindings="False">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="▶" FontSize="11" Foreground="#FFA6E3A1" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="#FFF0E8F4" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Compound section header -->
                                <Border Padding="12,10,12,2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <Border Width="3" Height="12" Background="#FFDCC4FF" CornerRadius="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="COMPOUND" FontSize="10" FontWeight="Bold"
                                                       Foreground="#FFDCC4FF" LetterSpacing="1"
                                                       VerticalAlignment="Center" Name="CompoundHeader"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="⚡ Управляти" Classes="action-button"
                                                FontSize="10" Padding="6,3" Name="ManageCompoundButton"
                                                ToolTip.Tip="Відкрити редактор Compound Run"/>
                                    </Grid>
                                </Border>
                                <ListBox Name="CompoundConfigsList" Background="Transparent"
                                         Margin="4,0" SelectionChanged="CompoundConfigsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:CompoundRunConfiguration" x:CompileBindings="False">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="⚡" FontSize="12" Foreground="#FFFFC09F" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#FFF0E8F4"/>
                                                    <TextBlock FontSize="10" Foreground="#FF9E90B0">
                                                        <Run Text="{Binding Configurations.Count}"/>
                                                        <Run Text=" проєктів"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Add/Remove Buttons -->
                        <Border Grid.Row="2" BorderBrush="#FF3E3050" BorderThickness="0,1,0,0" Padding="8,8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="+" Classes="action-button" Width="34" Height="30"
                                        FontSize="16" FontWeight="Bold" ToolTip.Tip="Додати конфігурацію"
                                        Name="AddConfigButton"/>
                                <Button Content="−" Classes="action-button" Width="34" Height="30"
                                        FontSize="16" ToolTip.Tip="Видалити конфігурацію"
                                        Name="RemoveConfigButton"/>
                                <Button Content="📋" Classes="action-button" Width="34" Height="30"
                                        ToolTip.Tip="Дублювати конфігурацію"
                                        Name="DuplicateConfigButton"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- Right Panel: Configuration Details -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Spacing="16" Name="ConfigDetailsPanel">

                        <!-- Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Назва" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FFFFC09F" Name="NameLabel"/>
                            <TextBox Name="ConfigNameBox" Watermark="Назва конфігурації"/>
                        </StackPanel>

                        <!-- Project -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Проєкт" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FFFFC09F" Name="ProjectLabel"/>
                            <ComboBox Name="ProjectComboBox" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Configuration (Debug/Release) + Framework -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                <TextBlock Text="Конфігурація збірки" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FFFFC09F" Name="BuildConfigLabel"/>
                                <ComboBox Name="BuildConfigComboBox" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Debug"/>
                                    <ComboBoxItem Content="Release"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                <TextBlock Text="Target Framework" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FFFFC09F" Name="FrameworkLabel"/>
                                <ComboBox Name="FrameworkComboBox" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <!-- Launch Profile -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Профіль запуску (необов'язково)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FFFFC09F" Name="LaunchProfileLabel"/>
                            <ComboBox Name="LaunchProfileComboBox" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Working Directory -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Робоча директорія" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FFFFC09F" Name="WorkingDirLabel"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="WorkingDirBox" Watermark="Шлях до робочої директорії"/>
                                <Button Grid.Column="1" Content="📁" Classes="action-button" Margin="6,0,0,0"
                                        Width="40" Name="BrowseWorkingDirButton"/>
                            </Grid>
                        </StackPanel>

                        <!-- Command Line Arguments -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Аргументи програми" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FFFFC09F" Name="ArgumentsLabel"/>
                            <TextBox Name="ArgumentsBox" Watermark="--arg1 value1 --arg2 value2"
                                     Height="64" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Environment Variables -->
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Змінні середовища" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FFFFC09F" Name="EnvVarsLabel" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ Додати" Classes="action-button"
                                        FontSize="11" Padding="8,4" Name="AddEnvVarButton"/>
                            </Grid>
                            <Border Background="#FF221C2C" CornerRadius="8" Padding="10" MinHeight="60"
                                    BorderBrush="#FF3E3050" BorderThickness="1">
                                <StackPanel Name="EnvVarsPanel" Spacing="4">
                                    <TextBlock Text="Змінні середовища не визначено" FontSize="11"
                                               Foreground="#FF736886" FontStyle="Italic" Name="NoEnvVarsText"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Options -->
                        <Border Background="#FF221C2C" CornerRadius="8" Padding="14"
                                BorderBrush="#FF3E3050" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="⚙" FontSize="13" Foreground="#FFFFC09F" VerticalAlignment="Center"/>
                                    <TextBlock Text="Параметри запуску" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FFFFC09F" VerticalAlignment="Center" Name="RunOptionsLabel"/>
                                </StackPanel>
                                <CheckBox Content="Дозволити паралельний запуск" Name="AllowParallelRunCheck"/>
                                <CheckBox Content="Збирати перед запуском" IsChecked="True" Name="BuildBeforeRunCheck"/>
                                <CheckBox Content="Активувати панель виводу при запуску" IsChecked="True"
                                          Name="ActivateToolWindowCheck"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#FF221C2C" BorderBrush="#FF3E3050" BorderThickness="0,1,0,0"
                    Padding="16,10" CornerRadius="0,0,10,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left: Run action -->
                    <Button Grid.Column="0" Content="▶  Запустити" Classes="primary-button" Name="RunButton"/>
                    <!-- Right: dialog actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Застосувати" Classes="action-button" Name="ApplyButton"/>
                        <Button Content="Скасувати" Classes="action-button" Name="CancelButton"/>
                        <Button Content="OK" Classes="primary-button" Name="OkButton"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>

