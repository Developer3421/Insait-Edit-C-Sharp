<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Insait_Edit_C_Sharp.App"
             xmlns:semi="https://irihi.tech/semi">

    <Application.Styles>
        <FluentTheme/>
        <!-- AvaloniaEdit Semi theme â€” styles only TextEditor parts,
             does NOT replace FluentTheme for the rest of the application -->
  

        <!-- Dark purple caret + soft orange background in all TextBoxes -->
        <Style Selector="TextBox">
            <Setter Property="CaretBrush" Value="#FF6C2FA0"/>
            <Setter Property="Background" Value="#FFF7F2EC"/>
            <Setter Property="Foreground" Value="#FF1F1A24"/>
            <Setter Property="BorderBrush" Value="#FFB8A6C4"/>
            <Setter Property="SelectionBrush" Value="#66E9C9B8"/>
            <Setter Property="SelectionForegroundBrush" Value="#FF1F1A24"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFF7F2EC"/>
        </Style>

        <!-- Global style for emoji icons - ensures color emoji rendering -->
        <Style Selector="TextBlock.emoji">
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Noto Color Emoji, Apple Color Emoji, Segoe UI Symbol"/>
        </Style>
    </Application.Styles>
</Application>